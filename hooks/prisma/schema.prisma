// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id Int @id @default(autoincrement())
  name String?
  email String
  password String
  zap Zap[]
}

model Zap{
  id String @id @default(uuid())
  userId Int
  user User @relation(fields: [userId],references: [id])
  trigger Trigger?
  action Actions[]
}

model Trigger{
  id String @id @default(uuid())
  zapId String @unique
  zap Zap @relation(fields: [zapId],references: [id])
  typeId String
  type Avilabletriggers @relation(fields: [typeId],references: [id])
  }

model Avilabletriggers{
  id String @id @default(uuid())
  triggerName String
  triggers Trigger[]
}


model Actions{
  id String @id @default(uuid())
  typeId String
  type AvilableActions @relation(fields: [typeId],references: [id])
  zapId String
  zap Zap @relation(fields: [zapId],references: [id])
  }

model AvilableActions{
  id String @id @default(uuid())
  actionName String
  actions Actions[]

}