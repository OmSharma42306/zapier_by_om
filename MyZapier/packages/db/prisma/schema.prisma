// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id Int @id @default(autoincrement())
  name String?
  email String
  password String
  zap Zap[]
}

model Zap{
  id String @id @default(uuid())
  userId Int
  triggerId String

// like already referenced foregin key in trigger table using zapId.. it
                    // good to have trigger id for querying data.
  trigger Trigger? // one to one
  action Action[] // one to many
  zapRuns ZapRuns[] // one to many
  user User @relation(fields: [userId],references: [id])
}

model Trigger{
  id String @id @default(uuid())
  zapId String @unique
  zap Zap @relation(fields: [zapId],references: [id])
  triggerId String
  type Avilabletriggers @relation(fields: [triggerId],references: [id])
  }

model Avilabletriggers{
  id String @id @default(uuid())
  triggerName String
  triggers Trigger[]
}


model Action{
  id String @id @default(uuid())
  actionId String
  zapId String
  //metadata Json
  type AvilableActions @relation(fields: [actionId],references: [id])
  zap Zap @relation(fields: [zapId],references: [id])
  sortingOrder Int @default(0)
  }

model AvilableActions{
  id String @id @default(uuid())
  actionName String
  actions Action[]

}

model ZapRuns{
  id String @id @default(uuid())
  zapId String
  metadata Json
  zap Zap @relation(fields: [zapId],references: [id])
  zapRunOutbox ZapRunOutbox?
  index Int @unique    // to maintain which type of trigger or action needs to run.
  // index : 1
}

model ZapRunOutbox{
  id String @id @default(uuid())
  zapRunId String @unique
  zapRun ZapRuns @relation(fields: [zapRunId],references: [id])
}